{
  "manifest_version": 3,
  "name": "Nifi 1.x Dark Mode",
  "version": "0.1.2",
  "description": "Dark theme for the Apache NiFi interface.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*/nifi/*", "*://*/nifi", "*://*/nifi-*content-viewer*", "*://*/nifi-*-ui-*"],
      "css": ["dark.css"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://*/nifi/*", "*://*/nifi"],
      "js": ["page-hook.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["*://*/nifi/*", "*://*/nifi"],
      "js": ["env-switcher.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "NiFi Dark Mode 1.x",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
